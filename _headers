# Cabeceras — Cloudflare Pages / Workers Assets
#
# Este fichero es el que MANDA en producción. netlify.toml se conserva por si
# alguna vez se vuelve a Netlify, pero Cloudflare no lo lee: cualquier cabecera
# que solo esté allí no existe para el visitante.
#
# Reglas: la ruta va sin sangrar, las cabeceras con dos espacios. La primera
# coincidencia gana para cada cabecera, así que lo específico va antes que /*.

# ---------------------------------------------------------------------------
# El portal de cliente no debe indexarse. El rewrite 200 de /portal/* devuelve
# su index.html para cualquier ruta, lo que multiplicaría URLs sin valor.
/portal/*
  X-Robots-Tag: noindex, nofollow

# Documentos internos: no deben aparecer en buscadores aunque alguien dé con la
# URL. El bloqueo efectivo está en _redirects.
/AUDITORIA.md
  X-Robots-Tag: noindex, nofollow
/HALLAZGOS.md
  X-Robots-Tag: noindex, nofollow
/INFORME-FINAL.md
  X-Robots-Tag: noindex, nofollow
/MOTION.md
  X-Robots-Tag: noindex, nofollow

# ---------------------------------------------------------------------------
# Caché
#
# Fuentes autoalojadas: el contenido nunca cambia bajo el mismo nombre.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Variantes derivadas del héroe, el logo y la imagen social.
/img/*
  Cache-Control: public, max-age=31536000, immutable

/robotPerfecto.png
  Cache-Control: public, max-age=31536000, immutable
/robotPerfecto.webp
  Cache-Control: public, max-age=31536000, immutable

# CSS y JS llevan cache-busting por query (?v=). Una semana con revalidación
# obligatoria acota el daño si alguien despliega sin subir el ?v=.
/css/*
  Cache-Control: public, max-age=604800, must-revalidate
/js/*
  Cache-Control: public, max-age=604800, must-revalidate

# El resto de imágenes sueltas.
/*.png
  Cache-Control: public, max-age=2592000
/*.webp
  Cache-Control: public, max-age=2592000
/*.avif
  Cache-Control: public, max-age=2592000
/*.jpg
  Cache-Control: public, max-age=2592000

# ---------------------------------------------------------------------------
# Seguridad, para todo el sitio.
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: frame-ancestors 'self'
