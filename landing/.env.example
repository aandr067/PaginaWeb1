# Endpoint al que el formulario de contacto envía el POST (JSON).
# El sitio actual de apftech.es ya tiene una Cloudflare Function en /api/contacto
# que responde { ok: true } cuando el lead se registra correctamente.
#
# En local, apunta a la URL absoluta de producción o a `wrangler pages dev`.
NEXT_PUBLIC_FORM_ENDPOINT=/api/contacto

# URL canónica del sitio, usada por los metadatos y el JSON-LD.
NEXT_PUBLIC_SITE_URL=https://apftech.es
